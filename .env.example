# Copiez ce fichier en .env et ajustez si besoin.
# Toutes les variables sont OPTIONNELLES : sans .env, Orchestra detecte le
# materiel et se connecte a l'Ollama local par defaut.
#
# Une variable deja definie dans l'environnement reel n'est jamais ecrasee
# par ce fichier.

# --- Endpoint d'inference ---------------------------------------------------
# Nom d'un backend declare dans config/backends.yaml.
#   Passerelles    : litellm | vllm | tgi | azure
#   Heberges       : openrouter | groq | together
#   Postes de trav.: ollama | lmstudio | llamacpp
# ORCHESTRA_BACKEND=litellm

# Repointe le backend actif sans editer le YAML, typiquement pour basculer un
# poste vers un serveur partage.
# ORCHESTRA_BASE_URL=http://gpu-server.interne:8000/v1

# --- Cles d'API -------------------------------------------------------------
# Une cle ne figure JAMAIS dans config/backends.yaml : le YAML declare le nom
# de la variable, la valeur vit ici (ou dans le gestionnaire de secrets).
# Renseignez seulement celle du backend que vous utilisez.
# LITELLM_API_KEY=
# VLLM_API_KEY=
# TGI_API_KEY=
# AZURE_OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# TOGETHER_API_KEY=

# --- Serveur Ollama ---------------------------------------------------------
# Utilise par le backend de type ollama.
OLLAMA_HOST=http://127.0.0.1:11434

# --- Profil materiel --------------------------------------------------------
# Laissez vide pour la detection automatique (recommande).
# Sans effet quand le backend actif impose ses propres modeles.
# Valeurs : cpu | xs | sm | md | lg | xl | xxl  (voir config/profiles.yaml)
# ORCHESTRA_PROFILE=xl

# --- Espace de travail des agents -------------------------------------------
# Racine par defaut sur laquelle les agents outilles peuvent lire et ecrire.
# Tout chemin en dehors est refuse, ainsi que les .env, .git, cles et .pem,
# qui restent invisibles meme en lecture.
#
# C'est un simple defaut : chaque appel MCP ou CLI peut designer une autre
# racine. Sans racine, les agents n'ont aucun outil et se contentent de
# produire du texte.
# ORCHESTRA_WORKSPACE=C:\chemin\vers\mon-projet

# Deverrouille l'outil run_command, qui execute des commandes dans l'espace de
# travail (lancer une suite de tests, un linter). Verrouille par defaut : un
# processus fils sort du confinement des outils fichiers. Ne l'activez que sur
# un depot dont vous acceptez qu'un modele y execute des commandes.
# ORCHESTRA_ALLOW_SHELL=1
