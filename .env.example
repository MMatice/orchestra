# Copiez ce fichier en .env et ajustez si besoin.
# Toutes les variables sont OPTIONNELLES : sans .env, Orchestra detecte le
# materiel et se connecte a l'Ollama local par defaut.
#
# Une variable deja definie dans l'environnement reel n'est jamais ecrasee
# par ce fichier.

# --- Serveur Ollama ---------------------------------------------------------
# Instance locale par defaut.
OLLAMA_HOST=http://127.0.0.1:11434

# Deploiement partage : pointez les postes vers un GPU mutualise. C'est le
# scenario qui a le plus de sens en equipe (un seul modele charge, amorti sur
# tout le monde).
# OLLAMA_HOST=http://gpu-server.interne:11434
#
# Attention : "0.0.0.0" est une adresse d'ECOUTE pour `ollama serve`, pas une
# adresse de CONNEXION. Orchestra la reecrit en 127.0.0.1, mais autant etre
# explicite ici.

# --- Profil materiel --------------------------------------------------------
# Laissez vide pour la detection automatique (recommande).
# Forcez une valeur pour cibler un serveur distant plus puissant que le poste
# local, ou pour brider volontairement la consommation memoire.
# Valeurs : cpu | xs | sm | md | lg | xl  (voir config/profiles.yaml)
# ORCHESTRA_PROFILE=xl
